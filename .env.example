# Citaflex — variables de entorno
# Copia este archivo a `.env` y completa los valores:
#   cp .env.example .env
#
# Los valores salen de Supabase: Settings > API (Project URL / anon key).
# No compartas tu service_role key; anon key es segura para el cliente.

# URL del proyecto de Supabase, p.ej. https://abcdxyz.supabase.co
VITE_SUPABASE_URL=

# Anon / public key de Supabase (Settings > API > Project API keys > anon public)
VITE_SUPABASE_ANON_KEY=

# Credenciales de prueba (se crean en la BD con los datos de demostración)
#   admin@salonbella.co / test1234
#   staff@salonbella.co / test1234
#   client@salonbella.co / test1234